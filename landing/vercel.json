{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "solenrich.com" }],
      "destination": "https://www.solenrich.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "(.*)\\.vercel\\.app" }],
      "destination": "https://www.solenrich.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/llms.txt", "destination": "https://api.solenrich.com/llms.txt" },
    { "source": "/openapi.json", "destination": "https://api.solenrich.com/openapi.json" },
    { "source": "/.well-known/x402", "destination": "https://api.solenrich.com/.well-known/x402" },
    { "source": "/.well-known/agent.json", "destination": "https://api.solenrich.com/.well-known/agent.json" }
  ],
  "headers": [
    {
      "source": "/og-image.png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" },
        { "key": "Content-Type", "value": "image/png" }
      ]
    },
    {
      "source": "/logo.png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" },
        { "key": "Content-Type", "value": "image/png" }
      ]
    }
  ]
}
